PORT=3000
# En tu PC (MongoDB Compass): mongodb://127.0.0.1:27017/fronted_vue
# Dentro de Docker, el compose usa host.docker.internal para llegar a ese mismo Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/fronted_vue
JWT_SECRET=local-development-secret-change-before-deploy
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@proyectos.com
ADMIN_PASSWORD=Admin123*
